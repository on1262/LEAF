+# Project addition: LoRA-aware checkpoint resume.
+#
+# verl's FSDPCheckpointManager only restores the sharded *model* state, which the
+# LoRA runs never save (save_contents=[optimizer,extra]); the trained adapter is
+# exported beside the shards as <ckpt>/lora_adapter and was never read back, so
+# every mid-run resume silently restarted the LoRA from B = 0 (or from the SEED
+# SFT adapter).  This module restores the adapter (and SDPO's EMA teacher
+# adapter) into the FSDP module and verifies the restore bit for bit, and holds
+# the hard checks that make a partial resume fail loudly.
+
+import glob
+import os
+import re
+import shutil
+from contextlib import nullcontext
+
+import torch
+
+ADAPTER_DIR = "lora_adapter"
+EMA_ADAPTER_DIR = "ema_lora_adapter"
+ADAPTER_FILE = "adapter_model.safetensors"
+_WRAPPER_TOKENS = ("_fsdp_wrapped_module.", "_checkpoint_wrapped_module.", "_orig_mod.")
+
+
+class ResumeError(RuntimeError):
+    """A resume that would not restore the full training state."""
+
+
+def adapter_file(checkpoint_dir: str, name: str = ADAPTER_DIR) -> str:
+    return os.path.join(checkpoint_dir, name, ADAPTER_FILE)
+
+
+def read_adapter(path: str) -> dict:
+    from safetensors.torch import load_file
+
+    if not os.path.exists(path):
+        raise ResumeError(f"LoRA resume: adapter file is missing: {path}")
+    return load_file(path, device="cpu")
+
+
+def lora_norms(params: dict) -> dict:
+    """Frobenius norm over all lora_A and over all lora_B tensors."""
+    sums = {"lora_A": 0.0, "lora_B": 0.0}
+    for key, value in params.items():
+        for part in sums:
+            if f".{part}." in key:
+                sums[part] += float(value.detach().double().pow(2).sum())
+    return {part: total**0.5 for part, total in sums.items()}
+
+
+def _peft_key(name: str, adapter_name: str) -> str:
+    for token in _WRAPPER_TOKENS:
+        name = name.replace(token, "")
+    # get_peft_model_state_dict drops the adapter name the same way.
+    return name.replace(f".{adapter_name}", "")
+
+
+def _full_params_ctx(module):
+    from verl.utils.fsdp_utils import fsdp_version
+
+    version = fsdp_version(module)
+    if version == 0:
+        return nullcontext()
+    if version == 1:
+        from torch.distributed.fsdp import FullyShardedDataParallel as FSDP
+
+        return FSDP.summon_full_params(module, writeback=True, recurse=True)
+    raise NotImplementedError("LoRA resume supports FSDP1 and plain modules only")
+
+
+def load_lora_params(module, params: dict, adapter_name: str = "default") -> int:
+    """Copy a saved PEFT adapter state dict into ``module``'s LoRA parameters.
+
+    Every tensor of the file must land on a parameter and every LoRA parameter
+    of the module must be covered, otherwise this raises.
+    """
+    remaining = dict(params)
+    uncovered = []
+    loaded = 0
+    marker = f".{adapter_name}."
+    with _full_params_ctx(module), torch.no_grad():
+        for name, param in module.named_parameters():
+            key = _peft_key(name, adapter_name)
+            if "lora_" not in key:
+                continue
+            # another adapter of a multi-adapter module (a no-op with one
+            # adapter: every LoRA parameter name carries ".default.")
+            if marker not in name:
+                continue
+            if key not in remaining:
+                uncovered.append(key)
+                continue
+            source = remaining.pop(key)
+            if tuple(source.shape) != tuple(param.shape):
+                raise ResumeError(
+                    f"LoRA resume: shape mismatch for {key}: file {tuple(source.shape)} vs model {tuple(param.shape)}"
+                )
+            param.data.copy_(source.to(device=param.device, dtype=param.dtype))
+            loaded += 1
+    if remaining:
+        raise ResumeError(f"LoRA resume: {len(remaining)} adapter tensors match no parameter, e.g. {next(iter(remaining))}")
+    if uncovered:
+        raise ResumeError(f"LoRA resume: {len(uncovered)} LoRA parameters not in the adapter file, e.g. {uncovered[0]}")
+    if loaded == 0:
+        raise ResumeError("LoRA resume: the model has no LoRA parameters")
+    return loaded
+
+
+def current_lora_params(module, adapter_name: str = "default") -> dict:
+    """The module's adapter, gathered exactly as the checkpoint writer does."""
+    from verl.utils.fsdp_utils import fsdp_version, layered_summon_lora_params
+
+    if fsdp_version(module) > 0:
+        return layered_summon_lora_params(module, adapter_name=adapter_name)
+    from peft.utils.save_and_load import get_peft_model_state_dict
+
+    return {k: v.detach().cpu() for k, v in get_peft_model_state_dict(module, adapter_name=adapter_name).items()}
+
+
+def verify_lora_params(module, expected: dict, label: str, adapter_name: str = "default") -> dict:
+    """Raise unless the module's adapter equals ``expected`` exactly."""
+    actual = current_lora_params(module, adapter_name=adapter_name)
+    if set(actual) != set(expected):
+        missing = sorted(set(expected) - set(actual))[:3]
+        extra = sorted(set(actual) - set(expected))[:3]
+        raise ResumeError(f"LoRA resume ({label}): key sets differ; missing {missing}, unexpected {extra}")
+    for key, value in expected.items():
+        if not torch.equal(actual[key].to(value.dtype), value):
+            diff = float((actual[key].double() - value.double()).abs().max())
+            raise ResumeError(f"LoRA resume ({label}): {key} differs from the checkpoint (max abs diff {diff:.3e})")
+    saved, loaded = lora_norms(expected), lora_norms(actual)
+    if saved["lora_B"] > 0 and loaded["lora_B"] == 0:
+        raise ResumeError(f"LoRA resume ({label}): loaded lora_B norm is 0 but the checkpoint's is {saved['lora_B']}")
+    return {"saved": saved, "loaded": loaded, "tensors": len(expected)}
+
+
+def restore_adapter(module, checkpoint_dir: str, name: str, label: str, adapter_name: str = "default") -> dict:
+    """Load <checkpoint_dir>/<name> into ``module`` and verify it; returns norms."""
+    params = read_adapter(adapter_file(checkpoint_dir, name))
+    loaded = load_lora_params(module, params, adapter_name=adapter_name)
+    report = verify_lora_params(module, params, label, adapter_name=adapter_name)
+    report["loaded_tensors"] = loaded
+    print(
+        f"[lora_resume] Loaded {label} adapter from {os.path.join(checkpoint_dir, name)}: "
+        f"{loaded} tensors, lora_B norm saved={report['saved']['lora_B']:.6f} "
+        f"loaded={report['loaded']['lora_B']:.6f}, lora_A norm saved={report['saved']['lora_A']:.6f} "
+        f"loaded={report['loaded']['lora_A']:.6f}",
+        flush=True,
+    )
+    return report
+
+
+def assert_resume_contents(checkpoint_manager, checkpoint_dir: str, is_lora: bool) -> None:
+    """Hard checks before a LoRA resume: all three parts must be loadable."""
+    if not is_lora:
+        return
+    contents = list(checkpoint_manager.checkpoint_load_contents)
+    for required in ("optimizer", "extra"):
+        if required not in contents:
+            raise ResumeError(
+                f"LoRA resume from {checkpoint_dir} with load_contents={contents}: '{required}' must be loaded "
+                "(set checkpoint.load_contents=[optimizer,extra])"
+            )
+    world, rank = checkpoint_manager.world_size, checkpoint_manager.rank
+    for stem in ("optim", "extra_state"):
+        path = os.path.join(checkpoint_dir, f"{stem}_world_size_{world}_rank_{rank}.pt")
+        if not os.path.exists(path):
+            raise ResumeError(f"LoRA resume: {path} is missing from the checkpoint being resumed")
+    path = adapter_file(checkpoint_dir)
+    if not os.path.exists(path):
+        raise ResumeError(f"LoRA resume: adapter {path} is missing from the checkpoint being resumed")
+
+
+def prune_checkpoints(root: str, keep_step: int) -> list:
+    """Delete every global_step_* directory under ``root`` except ``keep_step``.
+
+    Called only after the new checkpoint and the tracker file are written, so a
+    crash at any point leaves at least one complete checkpoint on disk.
+    """
+    keep = os.path.abspath(os.path.join(root, f"global_step_{keep_step}"))
+    if not os.path.isdir(keep):
+        raise ResumeError(f"refusing to prune: the checkpoint to keep does not exist: {keep}")
+    removed = []
+    for path in glob.glob(os.path.join(root, "global_step_*")):
+        if re.fullmatch(r"global_step_\d+", os.path.basename(path)) and os.path.abspath(path) != keep:
+            shutil.rmtree(path)
+            removed.append(path)
+    return removed
