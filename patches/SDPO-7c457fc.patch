+# --------------------------------------------------------------------------- #
+# Project addition: high-clipped full-vocabulary KLs.
+#
+# Per-token values are summed over the full vocabulary of per-entry contributions
+# c_v; entries with c_v > tau are constantized (sum_v min(c_v, tau)). The
+# log-softmaxes are taken in fp32 chunk by chunk and recomputed in backward, as in
+# _ChunkedFullVocabKL. The clip boundary follows torch.clamp's gradient: kept
+# where c_v <= tau.
+# --------------------------------------------------------------------------- #
+
+
+class _ChunkedHighClipForwardKL(torch.autograd.Function):
+    """Student loss sum_v min(t_v log(t_v / s_v), tau); gradient into the student only.
+
+    Returns ``(loss, forward_kl, reverse_kl, positive_mass, clipped_positive_mass,
+    clipped_vocab)`` per row: the clipped loss (differentiable), the unclipped
+    KL(t || s), KL(s || t), sum of the positive contributions, the positive
+    mass the clip removes (sum of c_v - tau over c_v > tau), and the number of
+    vocabulary entries above tau.
+    """
+
+    @staticmethod
+    def forward(ctx, student_logits, teacher_logits, tau: float, chunk_size: int):
+        rows = student_logits.shape[0]
+        device = student_logits.device
+        outs = [torch.empty(rows, dtype=torch.float32, device=device) for _ in range(6)]
+        for start in range(0, rows, chunk_size):
+            stop = min(start + chunk_size, rows)
+            student = torch.log_softmax(student_logits[start:stop].float(), dim=-1)
+            teacher = torch.log_softmax(teacher_logits[start:stop].float(), dim=-1)
+            teacher_probs = teacher.exp()
+            contributions = teacher_probs * (teacher - student)
+            outs[0][start:stop] = contributions.clamp(max=tau).sum(-1)
+            outs[1][start:stop] = contributions.sum(-1)
+            outs[2][start:stop] = (student.exp() * (student - teacher)).sum(-1)
+            outs[3][start:stop] = contributions.clamp(min=0).sum(-1)
+            outs[4][start:stop] = (contributions - tau).clamp(min=0).sum(-1)
+            outs[5][start:stop] = (contributions > tau).sum(-1).float()
+            del student, teacher, teacher_probs, contributions
+        ctx.save_for_backward(student_logits, teacher_logits)
+        ctx.tau = float(tau)
+        ctx.chunk_size = int(chunk_size)
+        ctx.mark_non_differentiable(*outs[1:])
+        return tuple(outs)
+
+    @staticmethod
+    def backward(ctx, grad_out, *unused):
+        student_logits, teacher_logits = ctx.saved_tensors
+        grad = torch.empty_like(student_logits)
+        rows = student_logits.shape[0]
+        for start in range(0, rows, ctx.chunk_size):
+            stop = min(start + ctx.chunk_size, rows)
+            student = torch.log_softmax(student_logits[start:stop].float(), dim=-1)
+            teacher = torch.log_softmax(teacher_logits[start:stop].float(), dim=-1)
+            teacher_probs = teacher.exp()
+            kept = teacher_probs * ((teacher_probs * (teacher - student)) <= ctx.tau)
+            # d/dlog s_v of min(c_v, tau) = -t_v [c_v <= tau]; through log_softmax:
+            # grad_j = g_j - s_j sum_v g_v with g = -t * kept
+            chunk_grad = student.exp() * kept.sum(-1, keepdim=True) - kept
+            grad[start:stop] = (chunk_grad * grad_out[start:stop, None]).to(grad.dtype)
+            del student, teacher, teacher_probs, kept, chunk_grad
+        return grad, None, None, None
+
+
+def chunked_high_clip_forward_kl(
+    student_logits: torch.Tensor,
+    teacher_logits: torch.Tensor,
+    tau: float,
+    chunk_size: int = 1024,
+) -> dict[str, torch.Tensor]:
+    """Per-row forward KL(teacher || student) with the per-entry high clip; see
+    :class:`_ChunkedHighClipForwardKL`. Each chunk's log-softmax and clip mask are
+    computed in fp32."""
+    if student_logits.shape != teacher_logits.shape:
+        raise ValueError(
+            f"student/teacher logits differ: {tuple(student_logits.shape)} vs {tuple(teacher_logits.shape)}"
+        )
+    if tau <= 0:
+        raise ValueError("the KL contribution clip threshold must be positive")
+    names = ("loss", "forward_kl", "reverse_kl", "positive_mass", "clipped_positive_mass", "clipped_vocab")
+    outs = _ChunkedHighClipForwardKL.apply(
+        student_logits, teacher_logits.detach(), float(tau), int(chunk_size)
+    )
+    return dict(zip(names, outs, strict=True))
