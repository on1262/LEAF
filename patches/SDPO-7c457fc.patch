--- /dev/null
+++ b/verl/utils/peft_compat.py
@@ -0,0 +1,21 @@
+"""Compatibility helpers for loading PEFT adapters."""
+
+
+def ensure_peft_transformers_compatibility() -> bool:
+    """Make PEFT 0.19's no-TP loader work with Transformers 4.57.
+
+    PEFT imports ``EmbeddingParallel`` before it checks whether a layer has a
+    tensor-parallel plan.  Transformers 4.57 does not expose that newer class.
+    The sentinel is never selected by a non-TP model; a real unsupported
+    embedding-TP plan still reaches PEFT's explicit unknown-plan error.
+    """
+    from transformers.integrations import tensor_parallel
+
+    if hasattr(tensor_parallel, "EmbeddingParallel"):
+        return False
+
+    class EmbeddingParallelUnavailable:
+        pass
+
+    tensor_parallel.EmbeddingParallel = EmbeddingParallelUnavailable
+    return True
