+def topk_logprobs_from_logits_with_chunking(
+    logits: torch.Tensor,
+    topk: int | None = None,
+    topk_indices: torch.Tensor | None = None,
+    chunk_size: int = 2048,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Compute normalized top-k log-probabilities in bounded token chunks.
+
+    Chunking is over every dimension except the vocabulary dimension.  This
+    bounds the temporary vocabulary-sized tensors created by ``topk`` and
+    ``logsumexp`` while preserving gradients through the selected logits.
+    """
+    if chunk_size <= 0:
+        raise ValueError(f"chunk_size must be positive, got {chunk_size}")
+    if logits.ndim < 2:
+        raise ValueError(f"logits must have at least two dimensions, got {logits.shape}")
+    if (topk is None) == (topk_indices is None):
+        raise ValueError("exactly one of topk and topk_indices must be provided")
+
+    prefix_shape = logits.shape[:-1]
+    vocab_size = logits.shape[-1]
+    flat_logits = logits.reshape(-1, vocab_size)
+    flat_indices = None
+    if topk_indices is not None:
+        if topk_indices.shape[:-1] != prefix_shape:
+            raise ValueError(
+                f"topk_indices shape {topk_indices.shape} does not match logits shape {logits.shape}"
+            )
+        flat_indices = topk_indices.reshape(-1, topk_indices.shape[-1])
+        k = topk_indices.shape[-1]
+    else:
+        k = min(int(topk), vocab_size)
+
+    logps_chunks = []
+    indices_chunks = []
+    for start in range(0, flat_logits.shape[0], chunk_size):
+        end = min(start + chunk_size, flat_logits.shape[0])
+        logits_chunk = flat_logits[start:end]
+        if flat_indices is None:
+            topk_logits_chunk, indices_chunk = torch.topk(logits_chunk, k, dim=-1)
+        else:
+            indices_chunk = flat_indices[start:end]
+            topk_logits_chunk = torch.gather(logits_chunk, dim=-1, index=indices_chunk)
+        normalizer_chunk = torch.logsumexp(logits_chunk, dim=-1, keepdim=True)
+        logps_chunks.append(topk_logits_chunk - normalizer_chunk)
+        indices_chunks.append(indices_chunk)
+
+    output_shape = (*prefix_shape, k)
+    return (
+        torch.cat(logps_chunks, dim=0).reshape(output_shape),
+        torch.cat(indices_chunks, dim=0).reshape(output_shape),
+    )
+
