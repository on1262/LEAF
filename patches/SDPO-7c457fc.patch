+# --------------------------------------------------------------------------- #
+# Project addition: Jensen-Shannon divergence, beta = 0.5.
+#
+# JSD(s, t) = 0.5 KL(s || m) + 0.5 KL(t || m), m = (s + t) / 2, summed over the
+# full vocabulary from per-entry terms d_v = 0.5 [s_v log(s_v / m_v) + t_v log(t_v / m_v)]
+# (each d_v >= 0). Optional high clip: sum_v min(d_v, tau), the clipped entries
+# constantized (kept where d_v <= tau, torch.clamp's gradient). The teacher is
+# stop-grad. Since m_v depends on s only through s_v, d d_v / d s_v = 0.5 log(s_v / m_v);
+# chunked / recomputed in backward as _ChunkedFullVocabKL.
+# --------------------------------------------------------------------------- #
+
+_LOG2 = math.log(2.0)
+
+
+class _ChunkedJSD(torch.autograd.Function):
+    """Per-row JSD_0.5(student, teacher), optionally high-clipped per vocabulary entry.
+
+    Returns ``(loss, jsd, forward_kl, reverse_kl, clipped_positive_mass, clipped_vocab)``
+    per row: the (clipped) loss (differentiable), the unclipped JSD, KL(t || s),
+    KL(s || t), sum of d_v - tau over d_v > tau, and the number of entries above tau
+    (both 0 without a clip).
+    """
+
+    @staticmethod
+    def forward(ctx, student_logits, teacher_logits, tau, chunk_size: int):
+        rows = student_logits.shape[0]
+        device = student_logits.device
+        outs = [torch.zeros(rows, dtype=torch.float32, device=device) for _ in range(6)]
+        for start in range(0, rows, chunk_size):
+            stop = min(start + chunk_size, rows)
+            student = torch.log_softmax(student_logits[start:stop].float(), dim=-1)
+            teacher = torch.log_softmax(teacher_logits[start:stop].float(), dim=-1)
+            mixture = torch.logaddexp(student, teacher).sub_(_LOG2)
+            student_probs, teacher_probs = student.exp(), teacher.exp()
+            terms = (student_probs * (student - mixture)).add_(teacher_probs * (teacher - mixture)).mul_(0.5)
+            del mixture
+            outs[1][start:stop] = terms.sum(-1)
+            if tau is None:
+                outs[0][start:stop] = outs[1][start:stop]
+            else:
+                outs[0][start:stop] = terms.clamp(max=tau).sum(-1)
+                outs[4][start:stop] = (terms - tau).clamp_(min=0).sum(-1)
+                outs[5][start:stop] = (terms > tau).sum(-1).float()
+            del terms
+            log_ratio = teacher - student
+            outs[2][start:stop] = (teacher_probs * log_ratio).sum(-1)
+            outs[3][start:stop] = -(student_probs * log_ratio).sum(-1)
+            del student, teacher, student_probs, teacher_probs, log_ratio
+        ctx.save_for_backward(student_logits, teacher_logits)
+        ctx.tau = None if tau is None else float(tau)
+        ctx.chunk_size = int(chunk_size)
+        ctx.mark_non_differentiable(*outs[1:])
+        return tuple(outs)
+
+    @staticmethod
+    def backward(ctx, grad_out, *unused):
+        student_logits, teacher_logits = ctx.saved_tensors
+        grad = torch.empty_like(student_logits)
+        rows = student_logits.shape[0]
+        for start in range(0, rows, ctx.chunk_size):
+            stop = min(start + ctx.chunk_size, rows)
+            student = torch.log_softmax(student_logits[start:stop].float(), dim=-1)
+            teacher = torch.log_softmax(teacher_logits[start:stop].float(), dim=-1)
+            mixture = torch.logaddexp(student, teacher).sub_(_LOG2)
+            probs = student.exp()
+            # w_v = d d_v / d log s_v = 0.5 s_v log(s_v / m_v) on the kept entries;
+            # through log_softmax: grad_j = w_j - s_j sum_v w_v
+            weight = probs * (student - mixture) * 0.5
+            if ctx.tau is not None:
+                terms = weight + 0.5 * teacher.exp() * (teacher - mixture)
+                weight = weight * (terms <= ctx.tau)
+                del terms
+            del teacher, mixture
+            chunk_grad = weight - probs * weight.sum(-1, keepdim=True)
+            grad[start:stop] = (chunk_grad * grad_out[start:stop, None]).to(grad.dtype)
+            del student, probs, weight, chunk_grad
+        return grad, None, None, None
+
+
+def chunked_jsd(student_logits: torch.Tensor, teacher_logits: torch.Tensor, tau: float | None = None,
