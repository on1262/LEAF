+    def _full_vocab_divergence_loss(self, model_inputs, temperature, loss_agg_mode, clip_tau=None,
+                                    divergence=None):
+        """Token-level full-vocabulary divergence between student and privileged teacher.
+
+        Both sides are the current policy; the teacher reads
+        ``teacher_input_ids`` (privileged prompt + the same response) under
+        no_grad. Only the logits of response-predicting rows are kept, and the
+        divergence is computed in row chunks (see ``chunked_full_vocab_kl``).
+
+        ``divergence`` None: the reverse KL (``self_distillation.alpha`` 1; 0 = forward
+        KL), high-clipped per vocabulary entry at ``clip_tau`` when given. ``"forward"`` /
+        ``"jsd"``: KL(teacher || student) / JSD_0.5, high-clipped per vocabulary entry at
+        ``clip_tau`` when given.
+        """
+        cfg = self.config.self_distillation
+        if divergence is None:
+            alpha = float(cfg.alpha)
+            if alpha not in (0.0, 1.0):
+                raise ValueError("the full-vocabulary KL supports alpha 1 (reverse KL) or 0 (forward KL)")
+        elif divergence not in ("forward", "jsd"):
+            raise ValueError(f"unknown divergence {divergence!r}")
+        chunk = int(cfg.get("vocab_chunk_size", 1024))
+        response_mask = model_inputs["response_mask"]
+        student = self._forward_micro_batch(
+            model_inputs, temperature=temperature, calculate_entropy=False,
+            return_response_logits=True,
+        )
+        teacher_inputs = {
+            "responses": model_inputs["responses"],
+            "response_mask": response_mask,
+            "input_ids": model_inputs["teacher_input_ids"],
+            "attention_mask": model_inputs["teacher_attention_mask"],
+            "position_ids": model_inputs["teacher_position_ids"],
+        }
+        with torch.no_grad():
+            teacher = self._forward_micro_batch(
+                teacher_inputs, temperature=temperature, calculate_entropy=False,
+                return_response_logits=True,
+            )
+        clip_stats = None
+        divergence_stats = None
+        if divergence == "forward":
+            if clip_tau is None:
+                rows = chunked_full_vocab_kl(
+                    student["response_logits"], teacher["response_logits"], reverse=False, chunk_size=chunk)
+            else:
+                # sum_v min(t_v log(t_v / s_v), tau)
+                divergence_stats = chunked_high_clip_forward_kl(
+                    student["response_logits"], teacher["response_logits"], float(clip_tau), chunk)
+                rows = divergence_stats["loss"]
+        elif divergence == "jsd":
+            divergence_stats = chunked_jsd(
+                student["response_logits"], teacher["response_logits"],
+                None if clip_tau is None else float(clip_tau), chunk)
+            rows = divergence_stats["loss"]
+        elif clip_tau is None:
+            rows = chunked_full_vocab_kl(
+                student["response_logits"], teacher["response_logits"],
+                reverse=alpha == 1.0, chunk_size=chunk,
+            )
+        else:
+            # sum_v min(s_v log(s_v / t_v), tau) (reverse only)
+            if alpha != 1.0:
+                raise ValueError("distill_reverse_kl_clip clips the reverse KL (alpha 1)")
+            clip_stats = chunked_high_clip_reverse_kl(
+                student["response_logits"], teacher["response_logits"], float(clip_tau), chunk)
+            rows = clip_stats["loss"]
+        teacher_log_prob = teacher["log_probs"]
+        del teacher
+        mask = response_mask.bool()
+        per_token = torch.zeros(response_mask.shape, dtype=rows.dtype, device=rows.device)
+        per_token = per_token.masked_scatter(mask, rows)
+        weights = model_inputs.get("rollout_is_weights", None)
+        if weights is not None:
+            per_token = per_token * weights
+        loss = agg_loss(loss_mat=per_token, loss_mask=response_mask, loss_agg_mode=loss_agg_mode)
+        with torch.no_grad():
+            valid = response_mask.sum().clamp(min=1)
+            metrics = {
+                "distill/kl_token_mean": (rows.sum() / valid).item(),
+                "distill/student_teacher_logp_gap": (
+                    ((student["log_probs"] - teacher_log_prob) * response_mask).sum() / valid
+                ).item(),
+            }
+            if clip_stats is not None:
+                metrics["reverse_kl_clip/reverse_kl_token_mean"] = (clip_stats["reverse_kl"].sum() / valid).item()
+                metrics["reverse_kl_clip/positive_mass_sum"] = clip_stats["positive_mass"].sum().item()
+                metrics["reverse_kl_clip/clipped_positive_mass_sum"] = clip_stats["clipped_positive_mass"].sum().item()
+            if divergence_stats is not None:
+                for key in ("jsd", "forward_kl", "reverse_kl"):
+                    if key in divergence_stats:
+                        metrics[f"divergence/{key}_token_mean"] = (divergence_stats[key].sum() / valid).item()
+                for key in ("clipped_positive_mass", "clipped_vocab"):
+                    metrics[f"divergence/{key}_sum"] = divergence_stats[key].sum().item()
+        return loss, metrics
+
+    def _distill_update_policy(self, data: DataProto, temperature, pad_token_id, loss_mode):
+        """Self-distillation: one optimizer step whose loss is an exact token mean over the step.
+
+        The verl scaling ``rows_in_micro / ppo_mini_batch_size`` would weight
+        micro batches by rows; here every micro batch contributes ``sum over its
+        response tokens / response tokens of the whole step``, whatever the
+        micro batching. The token loss is the full-vocabulary divergence toward
+        the current policy on ``teacher_input_ids`` (IS-weighted per token):
+        reverse KL (``distill_reverse_kl``), its high clip (``distill_reverse_kl_clip``)
+        or another divergence (:data:`DIVERGENCE_LOSS_MODES`). Micro batches are
+        packed by the teacher's token count, the longer of the two forwards.
+        """
+        if self.config.ppo_epochs != 1:
+            raise ValueError(f"{loss_mode} takes exactly one pass (ppo_epochs={self.config.ppo_epochs})")
+        if len(data) > self.config.ppo_mini_batch_size:
+            raise ValueError(
+                f"{loss_mode}: {len(data)} rows exceed ppo_mini_batch_size {self.config.ppo_mini_batch_size}; "
+                "the step would take more than one optimizer step"
+            )
+        step_tokens = float(data.batch["response_mask"].sum().item())
+        if step_tokens <= 0:
+            raise ValueError(f"{loss_mode}: the step has no response tokens")
+        clip_tau = float(data.meta_info["distill_clip_tau"]) if loss_mode in CLIPPED_DISTILL_LOSS_MODES else None
+        divergence = DIVERGENCE_LOSS_MODES[loss_mode][0] if loss_mode in DIVERGENCE_LOSS_MODES else None
+        if self.config.use_dynamic_bsz:
+            max_token_len = self.config.ppo_max_token_len_per_gpu * self.ulysses_sequence_parallel_size
+            packing = DataProto.from_dict(tensors={
+                "input_ids": data.batch["teacher_input_ids"],
+                "attention_mask": data.batch["teacher_attention_mask"],
+            })
+            _, index_lists = prepare_dynamic_batch(packing, max_token_len=max_token_len)
+            micro_batches = [data.select_idxs(list(indices)) for indices in index_lists]
+        else:
+            micro_batches = data.split(self.config.ppo_micro_batch_size_per_gpu)
+
+        # Per-step memory window: the peak before the reset covers the IS-weight
+        # pass of the step (since vLLM slept).
+        device = get_torch_device()
+        track = hasattr(device, "max_memory_allocated")  # absent on CPU (unit tests)
+        memory = {
+            "update/allocated_at_update_start_gb": device.memory_allocated() / 1024**3,
+            "update/peak_allocated_before_update_gb": device.max_memory_allocated() / 1024**3,
+        } if track else {}
+        if track:
+            device.reset_peak_memory_stats()
+        metrics = {"actor/pg_loss": 0.0}
+        kl_token_mean = 0.0
+        self.actor_optimizer.zero_grad()
+        for micro_batch in micro_batches:
+            micro_batch = micro_batch.to(get_device_id())
+            model_inputs = {**micro_batch.batch, **micro_batch.non_tensor_batch, "pad_token_id": pad_token_id}
+            share = model_inputs["response_mask"].sum().item() / step_tokens
+            token_mean, micro_batch_metrics = self._full_vocab_divergence_loss(
+                model_inputs, temperature, "token-mean", clip_tau=clip_tau, divergence=divergence
+            )
+            loss = token_mean * share
+            kl_token_mean += micro_batch_metrics["distill/kl_token_mean"] * share
+            loss.backward()
+            metrics["actor/pg_loss"] += loss.detach().item()
+            append_to_dict(metrics, micro_batch_metrics)
+            del loss
+        grad_norm = self._optimizer_step()
+        self.actor_optimizer.zero_grad()
+        if track:
+            memory["update/allocated_at_update_end_gb"] = device.memory_allocated() / 1024**3
+            memory["update/peak_allocated_update_gb"] = device.max_memory_allocated() / 1024**3
+        append_to_dict(metrics, {
+            "actor/grad_norm": grad_norm.detach().item(),
+            "update/step_response_tokens": step_tokens,
+            "update/micro_batches": float(len(micro_batches)),
+            # _optimizer_step skips optimizer.step() on a non-finite grad norm;
+            # 0 here makes the trainer stop instead of checkpointing the step.
+            "update/optimizer_steps": float(torch.isfinite(torch.as_tensor(grad_norm)).item()),
+            **memory,
+        })
+        metrics["update/kl_token_mean"] = kl_token_mean
+        return metrics
+
+    def _sft_update_policy(self, data: DataProto, pad_token_id):
+        """SFT: one optimizer step on the NLL of the response tokens (temperature 1),
+        each micro batch weighted by its share of the step's response tokens. Micro batches
+        are packed by the student's tokens (``ppo_max_token_len_per_gpu``)."""
+        loss_mode = SFT_LOSS_MODE
+        if self.config.ppo_epochs != 1:
+            raise ValueError(f"{loss_mode} takes exactly one pass (ppo_epochs={self.config.ppo_epochs})")
+        if len(data) > self.config.ppo_mini_batch_size:
+            raise ValueError(
+                f"{loss_mode}: {len(data)} rows exceed ppo_mini_batch_size {self.config.ppo_mini_batch_size}; "
+                "the step would take more than one optimizer step"
+            )
+        step_tokens = float(data.batch["response_mask"].sum().item())
+        if step_tokens <= 0:
+            raise ValueError(f"{loss_mode}: the step has no response tokens")
+        if self.config.use_dynamic_bsz:
+            max_token_len = self.config.ppo_max_token_len_per_gpu * self.ulysses_sequence_parallel_size
+            micro_batches, _ = prepare_dynamic_batch(data, max_token_len=max_token_len)
+        else:
+            micro_batches = data.split(self.config.ppo_micro_batch_size_per_gpu)
+        device = get_torch_device()
+        track = hasattr(device, "max_memory_allocated")  # absent on CPU (unit tests)
+        memory = {"update/allocated_at_update_start_gb": device.memory_allocated() / 1024**3} if track else {}
+        if track:
+            device.reset_peak_memory_stats()
+        metrics = {"actor/pg_loss": 0.0}
+        self.actor_optimizer.zero_grad()
+        for micro_batch in micro_batches:
+            micro_batch = micro_batch.to(get_device_id())
+            model_inputs = {**micro_batch.batch, **micro_batch.non_tensor_batch, "pad_token_id": pad_token_id}
+            response_mask = model_inputs["response_mask"]
+            outputs = self._forward_micro_batch(model_inputs, temperature=1.0, calculate_entropy=False)
+            loss = -(outputs["log_probs"] * response_mask).sum() / step_tokens
+            loss.backward()
+            metrics["actor/pg_loss"] += loss.detach().item()
+            del loss, outputs
+        grad_norm = self._optimizer_step()
+        self.actor_optimizer.zero_grad()
+        if track:
+            memory["update/allocated_at_update_end_gb"] = device.memory_allocated() / 1024**3
+            memory["update/peak_allocated_update_gb"] = device.max_memory_allocated() / 1024**3
+        append_to_dict(metrics, {
+            "actor/grad_norm": grad_norm.detach().item(),
+            "update/step_response_tokens": step_tokens,
+            "update/micro_batches": float(len(micro_batches)),
+            "update/optimizer_steps": float(torch.isfinite(torch.as_tensor(grad_norm)).item()),
+            **memory,
+        })
+        return metrics
+
