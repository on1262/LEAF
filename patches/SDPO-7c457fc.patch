+        raise ValueError("the JSD contribution clip threshold must be positive")
+    names = ("loss", "jsd", "forward_kl", "reverse_kl", "clipped_positive_mass", "clipped_vocab")
+    outs = _ChunkedJSD.apply(student_logits, teacher_logits.detach(), None if tau is None else float(tau),
