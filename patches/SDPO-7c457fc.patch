+class _ChunkedFullVocabKL(torch.autograd.Function):
+    """Per-row full-vocabulary KL between two logit matrices, in row chunks.
+
+    ``student_logits`` and ``teacher_logits`` are ``(n, V)`` rows already
+    divided by the sampling temperature. Only the student side receives a
+    gradient. Neither the fp32 log-softmax nor the probabilities are kept for
+    backward: each chunk is recomputed there, so the extra live memory is one
+    chunk of ``(chunk, V)`` fp32 temporaries rather than several ``(n, V)``
+    tensors.
+
+    ``reverse=True`` computes KL(student || teacher); ``reverse=False``
+    computes KL(teacher || student).
+    """
+
+    @staticmethod
+    def forward(ctx, student_logits, teacher_logits, reverse: bool, chunk_size: int):
+        rows = student_logits.shape[0]
+        out = torch.empty(rows, dtype=torch.float32, device=student_logits.device)
+        for start in range(0, rows, chunk_size):
+            stop = min(start + chunk_size, rows)
+            student = torch.log_softmax(student_logits[start:stop].float(), dim=-1)
+            teacher = torch.log_softmax(teacher_logits[start:stop].float(), dim=-1)
+            if reverse:
+                out[start:stop] = (student.exp() * (student - teacher)).sum(-1)
+            else:
+                out[start:stop] = (teacher.exp() * (teacher - student)).sum(-1)
+            del student, teacher
+        ctx.save_for_backward(student_logits, teacher_logits)
+        ctx.reverse = bool(reverse)
+        ctx.chunk_size = int(chunk_size)
+        return out
+
+    @staticmethod
+    def backward(ctx, grad_out):
+        student_logits, teacher_logits = ctx.saved_tensors
+        grad = torch.empty_like(student_logits)
+        rows = student_logits.shape[0]
+        for start in range(0, rows, ctx.chunk_size):
+            stop = min(start + ctx.chunk_size, rows)
+            student = torch.log_softmax(student_logits[start:stop].float(), dim=-1)
+            teacher = torch.log_softmax(teacher_logits[start:stop].float(), dim=-1)
+            probs = student.exp()
+            if ctx.reverse:
+                # d/dz_s sum_v p_s (log p_s - log p_t) = p_s * (log p_s - log p_t - KL)
+                diff = student - teacher
+                kl = (probs * diff).sum(-1, keepdim=True)
+                chunk_grad = probs * (diff - kl)
+                del diff, kl
+            else:
+                # d/dz_s sum_v p_t (log p_t - log p_s) = p_s - p_t
+                chunk_grad = probs - teacher.exp()
+            grad[start:stop] = (chunk_grad * grad_out[start:stop, None]).to(grad.dtype)
+            del student, teacher, probs, chunk_grad
+        return grad, None, None, None
+
+
+def chunked_full_vocab_kl(
+    student_logits: torch.Tensor,
+    teacher_logits: torch.Tensor,
+    reverse: bool,
+    chunk_size: int = 1024,
+) -> torch.Tensor:
+    """Row-wise full-vocabulary KL; see :class:`_ChunkedFullVocabKL`."""
+    if student_logits.shape != teacher_logits.shape:
+        raise ValueError(
+            f"student/teacher logits differ: {tuple(student_logits.shape)} vs "
+            f"{tuple(teacher_logits.shape)}"
+        )
+    return _ChunkedFullVocabKL.apply(
+        student_logits, teacher_logits.detach(), bool(reverse), int(chunk_size)
+    )
+
